{
  "manifest_version": 3,
  "name": "previewSign FIDO Bridge",
  "version": "1.0.0",
  "description": "Bridges previewSign WebAuthn extension to a native FIDO service, bypassing OS-level extension filtering.",
  "key": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "sign-extension@example.com",
      "strict_min_version": "121.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sign Extension Settings"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page.js", "pin.html", "pin-setup.html", "pin-setup.js", "pin-change.html", "pin-change.js", "touch.html", "select.html", "select.js"],
      "matches": ["https://*/*", "http://localhost/*"]
    }
  ]
}
